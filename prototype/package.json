{
  "name": "sado-desk",
  "version": "0.24.18",
  "private": true,
  "description": "사도 데스크 — 트릭컬 리바이브 사도 데스크탑 마스코트 (비공식 팬 프로젝트, Electron + spine-ts 4.1)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "test:flow": "node test/flow.js",
    "test:first-run": "node test/first-run.js",
    "pack": "electron-builder --win dir --x64",
    "dist": "electron-builder --win nsis --x64",
    "pyruntime": "python tools/make-pyruntime.py"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@esotericsoftware/spine-core": "^4.1.56",
    "@esotericsoftware/spine-webgl": "^4.1.56"
  },
  "productName": "사도 데스크",
  "build": {
    "appId": "kr.sadodesk.app",
    "productName": "사도 데스크",
    "copyright": "개인 사용 프로토타입. 캐릭터·보이스는 EPID Games 트릭컬 리바이브의 자산이며 재배포하지 않습니다.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "news.js",
      "ai.js",
      "settings-schema.js",
      "setup-window.js",
      "test-hooks.js",
      "selftalk.js",
      "screen-capture.js",
      "chat.js",
      "updater.js",
      "fullscreen-watch.js",
      "args.js",
      "cursor-poll.js",
      "app-log.js",
      "win-bounds.js",
      "renderer/**/*",
      "!renderer/**/*.bak.js",
      "!renderer/mascot-selftest.js",
      "data/**/*",
      "package.json",
      "node_modules/@esotericsoftware/**",
      "node_modules/@anthropic-ai/**"
    ],
    "extraResources": [
      {
        "from": "tools/extract-all.py",
        "to": "tools/extract-all.py"
      },
      {
        "from": "pyruntime",
        "to": "pyruntime",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "SadoDesk-Setup-${version}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "사도 데스크",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "SadoDesk-Setup-${version}.${ext}",
      "allowElevation": false
    },
    "compression": "normal",
    "npmRebuild": false,
    "electronLanguages": [
      "ko",
      "en-US"
    ]
  }
}
